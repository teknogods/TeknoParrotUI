  <GamePath2></GamePath2>
  <TestMenuParameter></TestMenuParameter>
  <TestMenuIsExecutable>false</TestMenuIsExecutable>
  <ExtraParameters></ExtraParameters>
  <TestMenuExtraParameters></TestMenuExtraParameters>
  <EmulationProfile>TeknoModel1</EmulationProfile>
  <GameProfileRevision>11</GameProfileRevision>
  <HasSeparateTestMode>false</HasSeparateTestMode>
  <EmulatorType>TeknoModel1</EmulatorType>
  <Is64Bit>true</Is64Bit>
  <ExecutableName>vr.zip</ExecutableName>
  <HasTwoExecutables>false</HasTwoExecutables>
  <Patreon>true</Patreon>
  <DevOnly>false</DevOnly>
  <ConfigValues>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>Input API</FieldName>
      <FieldValue>DirectInput</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>DirectInput</string>
        <string>XInput</string>
        <string>RawInput</string>
      </FieldOptions>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>Force Feedback Device</FieldName>
      <FieldValue>off</FieldValue>
      <FieldType>DynamicDropdown</FieldType>
      <Hint>Select direct SDL3 wheel force feedback or controller vibration. Requires model1haptic.exe from the TeknoModel1 package.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>VR</CategoryName>
      <FieldName>Enable VR</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Present independent geometric stereo views through OpenXR. Oculus Touch controls and headset audio are selected automatically when available.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>VR</CategoryName>
      <FieldName>Use VR Controls</FieldName>
      <FieldValue>1</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Use OpenXR controllers exclusively in VR. Turn this off to use TPUI mappings instead; head tracking remains enabled.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>VR</CategoryName>
      <FieldName>VR Depth</FieldName>
      <FieldValue>150</FieldValue>
      <FieldType>Slider</FieldType>
      <FieldMin>100</FieldMin>
      <FieldMax>200</FieldMax>
      <FieldOptions />
      <FieldStep>5</FieldStep>
      <Hint>Adjust OpenXR geometric stereo strength from 100% to 200%.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>DisplayMode</FieldName>
      <FieldValue>Fullscreen</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>Windowed</string>
        <string>Fullscreen</string>
      </FieldOptions>
      <Hint>Fullscreen uses borderless desktop output. VR presents to the active OpenXR headset.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Stretch to Fullscreen</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Stretch fullscreen output to fill the display, ignoring the game's original aspect ratio.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Internal Resolution</FieldName>
      <FieldValue>4</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>1</string>
        <string>2</string>
        <string>3</string>
        <string>4</string>
        <string>5</string>
        <string>6</string>
        <string>7</string>
        <string>8</string>
      </FieldOptions>
      <Hint>Sets Model 1 polygon rendering from native 1x through enhanced 8x. 4x is the balanced default.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Smooth Geometry</FieldName>
      <FieldValue>1</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Reduces wobble and preserves thin distant details at 2x-8x internal resolution by keeping fractional 3D vertex positions. Works with Vulkan and VR; ignored at native 1x and with software rendering. Off preserves the original geometry.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Extended Draw Distance</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Experimental: draws all course terrain in Virtua Racing (World), reducing distant terrain pop-in. May reduce performance. Works on desktop and in VR; off preserves the normal terrain selection.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Low Latency Mode</FieldName>
      <FieldValue>1</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Samples controls closer to frame presentation to reduce input delay. Enabled by default for capped desktop play. Turn off if frame pacing becomes uneven; ignored in VR, uncapped play, or legacy pacing.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Presentation Filter</FieldName>
      <FieldValue>ssaa</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>ssaa</string>
        <string>nearest</string>
        <string>linear</string>
        <string>bicubic</string>
      </FieldOptions>
      <Hint>SSAA averages high-resolution samples for smooth downscaling on desktop and VR; recommended at 4x/8x. With Lottes CRT, SSAA resolves to native CRT resolution before applying the shader. Nearest preserves hard pixels. Bicubic is desktop-only; VR uses nearest for bicubic.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>CRT Shader</FieldName>
      <FieldValue>None</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>None</string>
        <string>Lottes</string>
        <string>Lottes Downsample</string>
      </FieldOptions>
      <Hint>Desktop Vulkan only. Lottes applies scanlines, bloom, curvature, and a shadow mask. Select SSAA under Presentation Filter to downsample before CRT. Lottes Downsample is the legacy equivalent. CRT overrides other filters and sharpening; ignored in VR.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Use Bezel</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Put vr.png or default.png in TeknoModel1/bezels. Artwork blends over the game after CRT and colour effects. Only shown in fullscreen without Stretch to Fullscreen; ignored in VR.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Presentation Sharpening</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>0</string>
        <string>0.05</string>
        <string>0.1</string>
        <string>0.15</string>
        <string>0.2</string>
        <string>0.25</string>
