	<GameProfileRevision>17</GameProfileRevision>
	<HasSeparateTestMode>false</HasSeparateTestMode>
	<ExecutableName>arkndd.dll</ExecutableName>
	<EmulatorType>TeknoMacaw</EmulatorType>
	<InvertedMouseAxis>true</InvertedMouseAxis>
	<GunGame>true</GunGame>
	<Is64Bit>true</Is64Bit>
	<xAxisMin>0</xAxisMin>
	<xAxisMax>255</xAxisMax>
	<yAxisMin>0</yAxisMin>
	<yAxisMax>255</yAxisMax>
	<Use16BitAnalog>true</Use16BitAnalog>
	<DevOnly>false</DevOnly>
	<Patreon>true</Patreon>
	<ConfigValues>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Input API</FieldName>
			<FieldValue>DirectInput</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>DirectInput</string>
				<string>XInput</string>
				<string>RawInput</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>DisplayMode</FieldName>
			<FieldValue>Fullscreen</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>Windowed</string>
				<string>Fullscreen</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Region</FieldName>
			<FieldValue>Japan</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>Japan</string>
				<string>Asia</string>
			</FieldOptions>
			<Hint>Japan is the original region. Asia mode enables english language, but disables card saving and might cause slight bugs.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Hide Cursor</FieldName>
			<FieldValue>1</FieldValue>
			<FieldType>Bool</FieldType>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Render As Landscape</FieldName>
			<FieldValue>1</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Renders into a landscape window or fullscreen display. Dual Screen shows the game and scope side by side. Single Screen Scope overlays the scope on the game using the Scope button. Disable this setting for portrait output.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Landscape Resolution Width</FieldName>
			<FieldValue>1920</FieldValue>
			<FieldType>Text</FieldType>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Landscape Resolution Height</FieldName>
			<FieldValue>1080</FieldValue>
			<FieldType>Text</FieldType>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Screen Layout</FieldName>
			<FieldValue>Dual Screen</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>Dual Screen</string>
				<string>Single Screen Scope</string>
			</FieldOptions>
			<Hint>Dual Screen keeps the game and scope in separate views, shown side by side when Render As Landscape is enabled. Single Screen Scope overlays a circular scope on the merged gameplay and HUD using the Scope button. Both layouts support portrait and landscape output.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Scope Button Mode</FieldName>
			<VisibleWhen>Screen Layout</VisibleWhen>
			<VisibleWhenValue>Single Screen Scope</VisibleWhenValue>
			<FieldValue>Hold</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>Hold</string>
				<string>Toggle</string>
			</FieldOptions>
			<Hint>Single Screen Scope only: hold the Scope button to show the lens, or press once to show it and again to hide it.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Scope Scale (%)</FieldName>
			<FieldValue>100</FieldValue>
			<FieldType>Slider</FieldType>
			<FieldMin>25</FieldMin>
			<FieldMax>150</FieldMax>
			<FieldStep>1</FieldStep>
			<VisibleWhen>Screen Layout</VisibleWhen>
			<VisibleWhenValue>Single Screen Scope</VisibleWhenValue>
			<Hint>100% is the standard scope size. Lower values shrink the scope; values above 100% enlarge it and may extend beyond the game image.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Card ID</FieldName>
			<FieldValue></FieldValue>
			<FieldType>Text</FieldType>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
