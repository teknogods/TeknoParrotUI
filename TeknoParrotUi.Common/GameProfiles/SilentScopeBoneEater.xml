			<FieldName>Keyboard/Button Axis X/Y Sensitivity</FieldName>
			<FieldValue>10</FieldValue>
			<FieldType>Slider</FieldType>
			<FieldMin>1</FieldMin>
			<FieldMax>127</FieldMax>
			<FieldOptions />
		</FieldInformation>
	</ConfigValues>
