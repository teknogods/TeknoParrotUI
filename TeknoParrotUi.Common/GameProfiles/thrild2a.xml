<?xml version="1.0" encoding="utf-8"?>
<GameProfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<GamePath />
	<GamePath2 />
	<TestMenuParameter />
	<TestMenuIsExecutable>false</TestMenuIsExecutable>
	<ExtraParameters />
	<TestMenuExtraParameters />
	<EmulationProfile>TeknoViper</EmulationProfile>
	<GameProfileRevision>4</GameProfileRevision>
	<HasSeparateTestMode>false</HasSeparateTestMode>
	<EmulatorType>TeknoViper</EmulatorType>
	<Is64Bit>true</Is64Bit>
	<ExecutableName>thrild2.zip</ExecutableName>
	<ExecutableName2>*.chd</ExecutableName2>
	<HasTwoExecutables>true</HasTwoExecutables>
	<Patreon>true</Patreon>
	<HasTpoSupport>true</HasTpoSupport>
	<ConfigValues>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Input API</FieldName>
			<FieldValue>DirectInput</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>DirectInput</string>
				<string>XInput</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Use Keyboard/Button For Axis</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Keyboard/Button Axis Wheel Sensitivity</FieldName>
			<FieldValue>10</FieldValue>
			<FieldType>Slider</FieldType>
			<FieldMin>1</FieldMin>
			<FieldMax>127</FieldMax>
			<FieldOptions />
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Keyboard/Button Axis Pedal Sensitivity</FieldName>
			<FieldValue>10</FieldValue>
			<FieldType>Slider</FieldType>
			<FieldMin>1</FieldMin>
			<FieldMax>255</FieldMax>
			<FieldOptions />
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>DisplayMode</FieldName>
			<FieldValue>Fullscreen</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>Windowed</string>
				<string>Fullscreen</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Internal Resolution</FieldName>
			<FieldValue>4</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>1</string>
				<string>2</string>
				<string>4</string>
				<string>8</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Texture Filtering</FieldName>
			<FieldValue>trilinear</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>original</string>
				<string>trilinear</string>
				<string>max</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Presentation Resampling</FieldName>
			<FieldValue>bicubic</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>linear</string>
				<string>bicubic</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Audio</CategoryName>
			<FieldName>Mute Audio</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Performance</CategoryName>
			<FieldName>Prefer High Performance</FieldName>
			<FieldValue>1</FieldValue>
			<FieldType>Bool</FieldType>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Network</CategoryName>
			<FieldName>Cabinet Id</FieldName>
			<FieldValue>1</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>1</string>
				<string>2</string>
				<string>3</string>
				<string>4</string>
			</FieldOptions>
			<Hint>Select a unique cabinet node for each linked instance. GTI Club 2 supports four linked cabinets.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Network</CategoryName>
			<FieldName>Network Port</FieldName>
			<FieldValue>29972</FieldValue>
			<FieldType>Numeric</FieldType>
			<FieldMin>0</FieldMin>
			<FieldMax>65535</FieldMax>
			<Hint>Set the same non-zero UDP port on all cabinets cabinets to enable linking, and select a different Cabinet Id on each.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Network</CategoryName>
			<FieldName>Network Interface</FieldName>
			<FieldValue>auto</FieldValue>
			<FieldType>Text</FieldType>
			<Hint>Use auto normally. On VPN or multi-adapter PCs, enter the local IPv4 address of the adapter used for cabinet traffic.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Network</CategoryName>
			<FieldName>Network Diagnostics</FieldName>
			<FieldValue>1</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Print peer counts and packet diagnostics to the TeknoViper run log.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Textures</CategoryName>
			<FieldName>Load Texture Packs</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Will replace textures during runtime with custom ones you supplied. Can be expensive to enable CPU wise.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Textures</CategoryName>
			<FieldName>Texture Pack Root</FieldName>
			<FieldValue>.\TeknoViper\texture-packs</FieldValue>
			<FieldType>Text</FieldType>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Textures</CategoryName>
			<FieldName>Dump Textures</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Save every texture the game loads into the texture dump root folder, for editing and reapplying via texture-packs</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Textures</CategoryName>
			<FieldName>Texture Dump Root</FieldName>
			<FieldValue>.\TeknoViper\texture-dumps</FieldValue>
			<FieldType>Text</FieldType>
		</FieldInformation>
	</ConfigValues>
	<JoystickButtons>
		<JoystickButtons>
			<ButtonName>Test</ButtonName>
			<InputMapping>Test</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Service</ButtonName>
			<InputMapping>Service1</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Coin</ButtonName>
			<InputMapping>Coin1</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Start</ButtonName>
			<InputMapping>P1ButtonStart</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Shift Up</ButtonName>
			<InputMapping>P1Button1</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Shift Down</ButtonName>
			<InputMapping>P1Button2</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Handbrake</ButtonName>
			<InputMapping>P1Button3</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Wheel Axis</ButtonName>
			<InputMapping>Analog0</InputMapping>
			<AnalogType>Wheel</AnalogType>
			<HideWithKeyboardForAxis>true</HideWithKeyboardForAxis>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Wheel Axis Left</ButtonName>
			<InputMapping>Analog0</InputMapping>
			<AnalogType>Wheel</AnalogType>
			<HideWithXInput>true</HideWithXInput>
			<HideWithoutKeyboardForAxis>true</HideWithoutKeyboardForAxis>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Wheel Axis Right</ButtonName>
			<InputMapping>Analog0</InputMapping>
			<AnalogType>Wheel</AnalogType>
			<HideWithXInput>true</HideWithXInput>
			<HideWithoutKeyboardForAxis>true</HideWithoutKeyboardForAxis>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Gas</ButtonName>
			<InputMapping>Analog2</InputMapping>
			<AnalogType>Gas</AnalogType>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Brake</ButtonName>
			<InputMapping>Analog4</InputMapping>
			<AnalogType>Brake</AnalogType>
		</JoystickButtons>
	</JoystickButtons>
</GameProfile>
