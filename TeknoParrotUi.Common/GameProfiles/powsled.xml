<?xml version="1.0" encoding="utf-8"?>
<GameProfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <GamePath />
  <GamePath2 />
  <TestMenuParameter />
  <TestMenuIsExecutable>false</TestMenuIsExecutable>
  <ExtraParameters />
  <EmulationProfile>TeknoModel2</EmulationProfile>
  <GameProfileRevision>5</GameProfileRevision>
  <HasSeparateTestMode>false</HasSeparateTestMode>
  <EmulatorType>TeknoModel2</EmulatorType>
  <Is64Bit>true</Is64Bit>
  <ExecutableName>powsled.zip</ExecutableName>
  <HasTwoExecutables>false</HasTwoExecutables>
  <Patreon>true</Patreon>
  <DevOnly>true</DevOnly>
  <ConfigValues>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>Input API</FieldName>
      <FieldValue>DirectInput</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>DirectInput</string>
        <string>XInput</string>
        <string>RawInput</string>
      </FieldOptions>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>DisplayMode</FieldName>
      <FieldValue>Fullscreen</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>Windowed</string>
        <string>Fullscreen</string>
      </FieldOptions>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Renderer</FieldName>
      <FieldValue>vulkan</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>vulkan</string>
        <string>software</string>
      </FieldOptions>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Internal Resolution</FieldName>
      <FieldValue>4</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>1</string>
        <string>2</string>
        <string>4</string>
        <string>8</string>
      </FieldOptions>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Presentation Filter</FieldName>
      <FieldValue>linear</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>nearest</string>
        <string>linear</string>
        <string>bicubic</string>
        <string>lanczos</string>
        <string>ssaa</string>
      </FieldOptions>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Audio</CategoryName>
      <FieldName>Mute Audio</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>VR</CategoryName>
      <FieldName>Enable VR</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Use the active OpenXR headset with Vulkan rendering.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>VR</CategoryName>
      <FieldName>Use VR Controls</FieldName>
      <FieldValue>1</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Use OpenXR controllers in VR. Turn off to use TPUI bindings with head tracking. Hold controller Menu for VR settings; aim either hand and pull its trigger to select.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Storage</CategoryName>
      <FieldName>Save Root</FieldName>
      <FieldValue>.\TeknoModel2\nvram</FieldValue>
      <FieldType>Text</FieldType>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Stretch to Fullscreen</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Fill the entire display area. Off preserves the cabinet 4:3 aspect ratio.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Use Bezel</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Load TeknoModel2/bezels/ROMSET.png, falling back to default.png. PNG alpha defines the game opening.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>CRT Shader</FieldName>
      <FieldValue>None</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>None</string>
        <string>Lottes</string>
        <string>Lottes Downsample</string>
      </FieldOptions>
      <Hint>Lottes retains enhanced resolution; Lottes Downsample resolves to native CRT pixels first.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Network</CategoryName>
      <FieldName>Enable LAN</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Viper-style local multicast; no relay process or host address. Enable linked play in the game service menu.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Network</CategoryName>
      <FieldName>Network Port</FieldName>
      <FieldValue>42002</FieldValue>
      <FieldType>Text</FieldType>
      <Hint>Use the same UDP port on every cabinet, from 1 to 65535.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Network</CategoryName>
      <FieldName>Cabinet Number</FieldName>
      <FieldValue>1</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>1</string>
        <string>2</string>
        <string>3</string>
        <string>4</string>
        <string>5</string>
        <string>6</string>
        <string>7</string>
        <string>8</string>
      </FieldOptions>
      <Hint>Unique number from 1 to Cabinet Count. Cabinet 1 is master; the others are slaves.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Network</CategoryName>
      <FieldName>Cabinet Count</FieldName>
      <FieldValue>2</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>2</string>
        <string>3</string>
        <string>4</string>
        <string>5</string>
        <string>6</string>
        <string>7</string>
        <string>8</string>
      </FieldOptions>
      <Hint>Same count on every cabinet. All cabinets must be present before the ring starts; game limits still apply.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Network</CategoryName>
      <FieldName>Network Interface</FieldName>
      <FieldValue>auto</FieldValue>
      <FieldType>Text</FieldType>
      <Hint>auto or the local IPv4 address of the LAN adapter. Use separate Save Roots for cabinets running on one PC.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Network</CategoryName>
      <FieldName>Network Diagnostics</FieldName>
      <FieldValue>1</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Print LAN or TPOnline peer and frame statistics every five seconds. TPO lobby launches automatically use direct peers and override the LAN settings.</Hint>
    </FieldInformation>
  </ConfigValues>
  <JoystickButtons>
    <JoystickButtons>
      <ButtonName>Test Menu</ButtonName>
      <InputMapping>Test</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>Service</ButtonName>
      <InputMapping>Service1</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>P1 Coin</ButtonName>
      <InputMapping>Coin1</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>P1 Start</ButtonName>
      <InputMapping>P1ButtonStart</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>P2 Coin</ButtonName>
      <InputMapping>Coin2</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>P2 Start</ButtonName>
      <InputMapping>P2ButtonStart</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>Service 2</ButtonName>
      <InputMapping>Service2</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>P1 Entry</ButtonName>
      <InputMapping>P1Button1</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>P1 Call</ButtonName>
      <InputMapping>P1Button2</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>P2 Entry</ButtonName>
      <InputMapping>P2Button1</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>P2 Call</ButtonName>
      <InputMapping>P2Button2</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>Cancel Network Check</ButtonName>
      <InputMapping>P1Button3</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>Cancel Error</ButtonName>
      <InputMapping>P1Button4</InputMapping>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>P1 Right</ButtonName>
      <InputMapping>Analog0</InputMapping>
      <AnalogType>Gas</AnalogType>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>P1 Left</ButtonName>
      <InputMapping>Analog2</InputMapping>
      <AnalogType>Brake</AnalogType>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>P2 Right</ButtonName>
      <InputMapping>Analog4</InputMapping>
      <AnalogType>Gas</AnalogType>
    </JoystickButtons>
    <JoystickButtons>
      <ButtonName>P2 Left</ButtonName>
      <InputMapping>Analog6</InputMapping>
      <AnalogType>Brake</AnalogType>
    </JoystickButtons>
  </JoystickButtons>
</GameProfile>
