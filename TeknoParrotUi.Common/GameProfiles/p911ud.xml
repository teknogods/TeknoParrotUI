<?xml version="1.0" encoding="utf-8"?>
<GameProfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<GamePath></GamePath>
	<GamePath2></GamePath2>
	<TestMenuParameter></TestMenuParameter>
	<TestMenuIsExecutable>false</TestMenuIsExecutable>
	<ExtraParameters></ExtraParameters>
	<TestMenuExtraParameters></TestMenuExtraParameters>
	<EmulationProfile>TeknoViper</EmulationProfile>
	<GameProfileRevision>6</GameProfileRevision>
	<HasSeparateTestMode>false</HasSeparateTestMode>
	<EmulatorType>TeknoViper</EmulatorType>
	<Is64Bit>true</Is64Bit>
	<GunGame>true</GunGame>
	<InvertedMouseAxis>true</InvertedMouseAxis>
	<Use16BitAnalog>false</Use16BitAnalog>
	<xAxisMin>0</xAxisMin>
	<xAxisMax>255</xAxisMax>
	<yAxisMin>0</yAxisMin>
	<yAxisMax>255</yAxisMax>
	<ExecutableName>p911ud.zip</ExecutableName>
	<ExecutableName2>*.chd</ExecutableName2>
	<HasTwoExecutables>true</HasTwoExecutables>
	<Patreon>true</Patreon>
	<ConfigValues>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Input API</FieldName>
			<FieldValue>RawInput</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>DirectInput</string>
				<string>XInput</string>
				<string>RawInput</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>VR</CategoryName>
			<FieldName>Enable VR</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Present the game through OpenXR. The desktop window remains available as a spectator view.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>VR</CategoryName>
			<FieldName>Use VR Controls</FieldName>
			<FieldValue>1</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>When VR is enabled, use OpenXR headset controllers. Turn this off to keep using TPUI shared-pipe or Xbox controls in VR.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>VR</CategoryName>
			<FieldName>VR Depth</FieldName>
			<FieldValue>150</FieldValue>
			<FieldType>Slider</FieldType>
			<FieldMin>100</FieldMin>
			<FieldMax>200</FieldMax>
			<FieldOptions />
			<FieldStep>5</FieldStep>
			<Hint>Adjust OpenXR stereo depth from 100% to 200%. Only used when VR is enabled.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>DisplayMode</FieldName>
			<FieldValue>Fullscreen</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>Windowed</string>
				<string>Fullscreen</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Stretch to Fullscreen</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Stretch fullscreen output to fill the display, ignoring the game's original aspect ratio.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Internal Resolution</FieldName>
			<FieldValue>4</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>1</string>
				<string>2</string>
				<string>4</string>
				<string>8</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Texture Filtering</FieldName>
			<FieldValue>trilinear</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>original</string>
				<string>nearest</string>
				<string>trilinear</string>
				<string>max</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Presentation Resampling</FieldName>
			<FieldValue>bicubic</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>nearest</string>
				<string>linear</string>
				<string>bicubic</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>CRT Shader</FieldName>
			<FieldValue>None</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>None</string>
				<string>Lottes</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Use Bezel</FieldName>
			<FieldValue>1</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Put either p911ud.png or default.png into the bezels folder in the TeknoViper folder. Only enabled in fullscreen mode.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Crosshairs</FieldName>
			<FieldValue>1</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Draw the P1 sight using crosshairs\P1.png, with the built-in sight as fallback. Disable for an external light-gun overlay.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Audio</CategoryName>
			<FieldName>Mute Audio</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Performance</CategoryName>
			<FieldName>Prefer High Performance</FieldName>
			<FieldValue>1</FieldValue>
			<FieldType>Bool</FieldType>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Textures</CategoryName>
			<FieldName>Load Texture Packs</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Will replace textures during runtime with custom ones you supplied. Can be expensive to enable CPU wise.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Textures</CategoryName>
			<FieldName>Texture Pack Root</FieldName>
			<FieldValue>.\TeknoViper\texture-packs</FieldValue>
			<FieldType>Text</FieldType>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Textures</CategoryName>
			<FieldName>Dump Textures</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Save every texture the game loads into the texture dump root folder, for editing and reapplying via texture-packs</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Textures</CategoryName>
			<FieldName>Texture Dump Root</FieldName>
			<FieldValue>.\TeknoViper\texture-dumps</FieldValue>
			<FieldType>Text</FieldType>
		</FieldInformation>
	</ConfigValues>
	<JoystickButtons>
		<JoystickButtons>
			<ButtonName>Test</ButtonName>
			<InputMapping>Test</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Service</ButtonName>
			<InputMapping>Service1</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Coin</ButtonName>
			<InputMapping>Coin1</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Start</ButtonName>
			<InputMapping>P1ButtonStart</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Trigger</ButtonName>
			<InputMapping>P1Button1</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Reload</ButtonName>
			<InputMapping>P1Button2</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Body Up</ButtonName>
			<InputMapping>P1ButtonUp</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Body Down</ButtonName>
			<InputMapping>P1ButtonDown</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Body Left</ButtonName>
			<InputMapping>P1ButtonLeft</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Body Right</ButtonName>
			<InputMapping>P1ButtonRight</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Gun X</ButtonName>
			<InputMapping>Analog0</InputMapping>
			<AnalogType>AnalogJoystick</AnalogType>
			<HideWithRawInput>true</HideWithRawInput>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Gun Y</ButtonName>
			<InputMapping>Analog2</InputMapping>
			<AnalogType>AnalogJoystick</AnalogType>
			<HideWithRawInput>true</HideWithRawInput>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Light Gun</ButtonName>
			<InputMapping>P1LightGun</InputMapping>
			<HideWithDirectInput>true</HideWithDirectInput>
			<HideWithXInput>true</HideWithXInput>
		</JoystickButtons>
	</JoystickButtons>
</GameProfile>
