<?xml version="1.0" encoding="utf-8"?>
<GameProfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<GamePath></GamePath>
	<TestMenuParameter></TestMenuParameter>
	<TestMenuIsExecutable>false</TestMenuIsExecutable>
	<ExtraParameters></ExtraParameters>
	<TestMenuExtraParameters></TestMenuExtraParameters>
	<ResetHint>false</ResetHint>
	<EmulationProfile>IncredibleTechnologies</EmulationProfile>
	<GameProfileRevision>10</GameProfileRevision>
	<HasSeparateTestMode>false</HasSeparateTestMode>
	<Is64Bit>false</Is64Bit>
	<DevOnly>false</DevOnly>
	<EmulatorType>ElfLdr2</EmulatorType>
	<Patreon>true</Patreon>
	<RequiresAdmin>false</RequiresAdmin>
	<InvertedMouseAxis>false</InvertedMouseAxis>
	<GunGame>true</GunGame>
	<ExecutableName>bowl-2.2.1|bowlgold</ExecutableName>
	<xAxisMin>0</xAxisMin>
	<xAxisMax>255</xAxisMax>
	<yAxisMin>0</yAxisMin>
	<yAxisMax>255</yAxisMax>
	<ConfigValues>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Input API</FieldName>
			<FieldValue>RawInputTrackball</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>DirectInput</string>
				<string>XInput</string>
				<string>RawInput</string>
				<string>RawInputTrackball</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Windowed</FieldName>
			<FieldValue>1</FieldValue>
			<FieldType>Bool</FieldType>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Frame Limit</FieldName>
			<FieldValue>60</FieldValue>
			<FieldType>Slider</FieldType>
			<FieldMin>0</FieldMin>
			<FieldMax>240</FieldMax>
			<FieldOptions></FieldOptions>
			<Hint>Frames per second limit, 0 = unlimited. Some 2D animations are tied to the frame rate, the game was made for 60.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Free Play</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Overrides the free play setting in the test menu.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>MSAA Level</FieldName>
			<FieldValue>0x</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>0x</string>
				<string>2x</string>
				<string>4x</string>
				<string>8x</string>
			</FieldOptions>
			<Hint>Enables MSAA (Multi Sample Anti Aliasing) at the specified level, if possible on your GPU. </Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Custom Resolution</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Renders at this resolution. In windowed mode it sets the window size, in fullscreen it switches the display to this resolution. The 3D view is widened to match the aspect ratio either way.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Custom Resolution Width</FieldName>
			<FieldValue>1920</FieldValue>
			<FieldType>Text</FieldType>
			<Hint>The games default width is 640</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Custom Resolution Height</FieldName>
			<FieldValue>1080</FieldValue>
			<FieldType>Text</FieldType>
			<Hint>The games default height is 480</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Aspect Ratio</FieldName>
			<FieldValue>Widescreen</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>Widescreen</string>
				<string>Original 4:3</string>
			</FieldOptions>
			<Hint>Widescreen will fill the entire screen in 3d scenes. Original 4:3 keeps the whole game 4:3 in the middle of the screen with black bars (or a bezel) on the sides.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>HUD Scaling</FieldName>
			<FieldValue>Stretch</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>Stretch</string>
				<string>Centered 4:3</string>
			</FieldOptions>
			<Hint>Widescreen only: how the 4:3 HUD and menus are shown. Stretch fills the screen, Centered 4:3 keeps them in their original sizes in the center.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Controls</CategoryName>
			<FieldName>Trackball Sensitivity X</FieldName>
			<FieldValue>100</FieldValue>
			<FieldType>Slider</FieldType>
			<FieldMin>1</FieldMin>
			<FieldMax>200</FieldMax>
			<FieldOptions></FieldOptions>
			<Hint>Scales the trackballs X input. Percent, so 100 = 100%, 25 = 25%</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Controls</CategoryName>
			<FieldName>Trackball Sensitivity Y</FieldName>
			<FieldValue>100</FieldValue>
			<FieldType>Slider</FieldType>
			<FieldMin>1</FieldMin>
			<FieldMax>200</FieldMax>
			<FieldOptions></FieldOptions>
			<Hint>Scales the trackballs Y input. Percent, so 100 = 100%, 25 = 25%</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Bezel</CategoryName>
			<FieldName>Enable</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Place bezel.png in the game folder. Shown around the game, which is kept at Original 4:3. Transparent pixels show the game. If enabled, will disable Widescreen.</Hint>
		</FieldInformation>
	</ConfigValues>
	<JoystickButtons>
		<JoystickButtons>
			<ButtonName>Test</ButtonName>
			<InputMapping>Test</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Service</ButtonName>
			<InputMapping>Service1</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Coin 1</ButtonName>
			<InputMapping>Coin1</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Coin 2</ButtonName>
			<InputMapping>Coin2</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Coin 3</ButtonName>
			<InputMapping>P2Button1</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Volume Up</ButtonName>
			<InputMapping>P1ButtonUp</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Volume Down</ButtonName>
			<InputMapping>P1ButtonDown</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Start (Push 4 / Test Menu Enter)</ButtonName>
			<InputMapping>P1ButtonStart</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Instant Replay (Push 1 / Test Menu Up)</ButtonName>
			<InputMapping>P1Button1</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Score Sheet (Push 2 / Test Menu Down)</ButtonName>
			<InputMapping>P1Button2</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Jukebox (Push 3)</ButtonName>
			<InputMapping>P1Button3</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Horizontal 1 (Yellow)</ButtonName>
			<InputMapping>P1Button4</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Horizontal 2 (Green)</ButtonName>
			<InputMapping>P1Button5</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Vertical 1 (Violet)</ButtonName>
			<InputMapping>P1Button6</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>Vertical 2 (Blue)</ButtonName>
			<InputMapping>P2ButtonStart</InputMapping>
		</JoystickButtons>
		<JoystickButtons>
			<ButtonName>TrackBall</ButtonName>
			<InputMapping>P1Trackball</InputMapping>
			<HideWithDirectInput>true</HideWithDirectInput>
			<HideWithXInput>true</HideWithXInput>
		</JoystickButtons>
	</JoystickButtons>
</GameProfile>
