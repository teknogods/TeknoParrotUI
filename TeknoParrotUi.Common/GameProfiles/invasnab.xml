			<FieldOptions>
				<string>native</string>
				<string>4:3</string>
				<string>16:9</string>
				<string>stretch</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Presentation Filter</FieldName>
			<FieldValue>linear</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>point</string>
				<string>linear</string>
				<string>bicubic</string>
				<string>ssaa</string>
			</FieldOptions>
		</FieldInformation>
