			<CategoryName>Video</CategoryName>
			<FieldName>CRT Shader</FieldName>
			<FieldValue>None</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>None</string>
				<string>Lottes</string>
				<string>Lottes Downsample</string>
			</FieldOptions>
			<Hint>Lottes adds curvature, scanlines and phosphor glow. Downsample first resolves internal rendering to native resolution. Disabled in VR.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>Use Bezel</FieldName>
			<FieldValue>0</FieldValue>
			<FieldType>Bool</FieldType>
			<Hint>Fullscreen only. Loads TeknoZeus/bezels/&lt;set&gt;.png or default.png. Disabled in VR.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Video</CategoryName>
			<FieldName>VSync</FieldName>
			<FieldValue>1</FieldValue>
			<FieldType>Bool</FieldType>
