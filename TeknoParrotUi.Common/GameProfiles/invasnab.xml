			<CategoryName>General</CategoryName>
			<FieldName>Input API</FieldName>
			<FieldValue>RawInput</FieldValue>
			<FieldType>Dropdown</FieldType>
			<FieldOptions>
				<string>DirectInput</string>
				<string>XInput</string>
				<string>RawInput</string>
			</FieldOptions>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>ROM Root</FieldName>
			<FieldValue />
			<FieldType>Text</FieldType>
			<Hint>Optional override for the folder containing MAME ZIPs. Otherwise uses the selected ZIP folder.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>General</CategoryName>
			<FieldName>Save Root</FieldName>
			<FieldValue>.\TeknoZeus\state</FieldValue>
			<FieldType>Text</FieldType>
