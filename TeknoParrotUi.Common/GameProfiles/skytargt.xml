      <CategoryName>Video</CategoryName>
      <FieldName>Renderer</FieldName>
      <FieldValue>vulkan</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>vulkan</string>
        <string>software</string>
      </FieldOptions>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Internal Resolution</FieldName>
      <FieldValue>4</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>1</string>
        <string>2</string>
        <string>4</string>
        <string>8</string>
      </FieldOptions>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Presentation Filter</FieldName>
      <FieldValue>linear</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>nearest</string>
        <string>linear</string>
        <string>bicubic</string>
        <string>lanczos</string>
        <string>ssaa</string>
      </FieldOptions>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Audio</CategoryName>
      <FieldName>Mute Audio</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>VR</CategoryName>
      <FieldName>Enable VR</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Use the active OpenXR headset with Vulkan rendering.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>VR</CategoryName>
      <FieldName>Use VR Controls</FieldName>
      <FieldValue>1</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Use OpenXR controllers in VR. Turn off to use TPUI bindings with head tracking. Hold controller Menu for VR settings; aim either hand and pull its trigger to select.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Storage</CategoryName>
      <FieldName>Save Root</FieldName>
      <FieldValue>.\TeknoModel2\nvram</FieldValue>
      <FieldType>Text</FieldType>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Stretch to Fullscreen</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Fill the entire display area. Off preserves the cabinet 4:3 aspect ratio.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Use Bezel</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Load TeknoModel2/bezels/ROMSET.png, falling back to default.png. PNG alpha defines the game opening.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>CRT Shader</FieldName>
      <FieldValue>None</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>None</string>
        <string>Lottes</string>
        <string>Lottes Downsample</string>
      </FieldOptions>
      <Hint>Lottes retains enhanced resolution; Lottes Downsample resolves to native CRT pixels first.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Input</CategoryName>
      <FieldName>Use Keyboard/Button For Axis</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>DirectInput only. Bind the separate axis directions in Controller Setup to use keyboard keys or controller buttons.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Input</CategoryName>
      <FieldName>Keyboard/Button Axis X/Y Sensitivity</FieldName>
      <FieldValue>10</FieldValue>
      <FieldType>Slider</FieldType>
      <FieldMin>1</FieldMin>
      <FieldMax>127</FieldMax>
    </FieldInformation>
