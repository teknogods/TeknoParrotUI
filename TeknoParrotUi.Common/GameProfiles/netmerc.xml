<?xml version="1.0" encoding="utf-8"?>
<GameProfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <GamePath></GamePath>
  <GamePath2></GamePath2>
  <TestMenuParameter></TestMenuParameter>
  <TestMenuIsExecutable>false</TestMenuIsExecutable>
  <ExtraParameters></ExtraParameters>
  <TestMenuExtraParameters></TestMenuExtraParameters>
  <EmulationProfile>TeknoModel1</EmulationProfile>
  <GameProfileRevision>5</GameProfileRevision>
  <HasSeparateTestMode>false</HasSeparateTestMode>
  <EmulatorType>TeknoModel1</EmulatorType>
  <Is64Bit>true</Is64Bit>
  <GunGame>true</GunGame>
  <InvertedMouseAxis>true</InvertedMouseAxis>
  <Use16BitAnalog>false</Use16BitAnalog>
  <xAxisMin>0</xAxisMin>
  <xAxisMax>255</xAxisMax>
  <yAxisMin>0</yAxisMin>
  <yAxisMax>255</yAxisMax>
  <ExecutableName>netmerc.zip</ExecutableName>
  <HasTwoExecutables>false</HasTwoExecutables>
  <Patreon>true</Patreon>
  <DevOnly>false</DevOnly>
  <ConfigValues>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>Input API</FieldName>
      <FieldValue>RawInput</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>DirectInput</string>
        <string>XInput</string>
        <string>RawInput</string>
      </FieldOptions>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>General</CategoryName>
      <FieldName>Force Feedback Device</FieldName>
      <FieldValue>off</FieldValue>
      <FieldType>DynamicDropdown</FieldType>
      <Hint>Select direct SDL3 wheel force feedback or controller vibration. Requires model1haptic.exe from the TeknoModel1 package.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>VR</CategoryName>
      <FieldName>Enable VR</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Present independent geometric stereo views through OpenXR. Oculus Touch controls and headset audio are selected automatically when available.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>VR</CategoryName>
      <FieldName>Use VR Controls</FieldName>
      <FieldValue>1</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Use OpenXR controllers exclusively in VR. Turn this off to use TPUI mappings instead; head tracking remains enabled.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>VR</CategoryName>
      <FieldName>VR Depth</FieldName>
      <FieldValue>150</FieldValue>
      <FieldType>Slider</FieldType>
      <FieldMin>100</FieldMin>
      <FieldMax>200</FieldMax>
      <FieldOptions />
      <FieldStep>5</FieldStep>
      <Hint>Adjust OpenXR geometric stereo strength from 100% to 200%.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>DisplayMode</FieldName>
      <FieldValue>Fullscreen</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>Windowed</string>
        <string>Fullscreen</string>
      </FieldOptions>
      <Hint>Fullscreen uses borderless desktop output. VR presents to the active OpenXR headset.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Internal Resolution</FieldName>
      <FieldValue>4</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>1</string>
        <string>2</string>
        <string>3</string>
        <string>4</string>
        <string>5</string>
        <string>6</string>
        <string>7</string>
        <string>8</string>
      </FieldOptions>
      <Hint>Sets Model 1 polygon rendering from native 1x through enhanced 8x. 4x is the balanced default.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Video</CategoryName>
      <FieldName>Presentation Filter</FieldName>
      <FieldValue>nearest</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>nearest</string>
        <string>linear</string>
      </FieldOptions>
      <Hint>Nearest is recommended for VR and preserves sharp native pixels; linear smooths desktop scaling.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Audio</CategoryName>
      <FieldName>Mute Audio</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Audio</CategoryName>
      <FieldName>NetMerc Audio Donor</FieldName>
      <FieldValue>vf</FieldValue>
      <FieldType>Dropdown</FieldType>
      <FieldOptions>
        <string>vf</string>
        <string>vr</string>
        <string>swa</string>
        <string>wingwar</string>
        <string>off</string>
      </FieldOptions>
      <Hint>Virtua Fighter is the default donor-assisted recovery bank. Donor ROMs are read from your own merged ROM directory; off uses the procedural fallback.</Hint>
    </FieldInformation>    <FieldInformation>
      <CategoryName>Cabinet</CategoryName>
      <FieldName>Cabinet Outputs</FieldName>
      <FieldValue>0</FieldValue>
      <FieldType>Bool</FieldType>
      <Hint>Publish the emulated output latch to compatible Windows cabinet-output clients.</Hint>
    </FieldInformation>
    <FieldInformation>
      <CategoryName>Storage</CategoryName>
      <FieldName>Save Root</FieldName>
      <FieldValue>.\TeknoModel1\saves</FieldValue>
      <FieldType>Text</FieldType>
      <Hint>Stores per-game NVRAM, I/O EEPROM, and persistent VR calibration.</Hint>
    </FieldInformation>
  </ConfigValues>
  <JoystickButtons>
    <JoystickButtons><ButtonName>Test Menu</ButtonName><InputMapping>Test</InputMapping></JoystickButtons>
    <JoystickButtons><ButtonName>Service</ButtonName><InputMapping>Service1</InputMapping></JoystickButtons>
    <JoystickButtons><ButtonName>Coin</ButtonName><InputMapping>Coin1</InputMapping></JoystickButtons>
    <JoystickButtons><ButtonName>Trigger</ButtonName><InputMapping>P1Button1</InputMapping></JoystickButtons>
    <JoystickButtons><ButtonName>Thumb Button</ButtonName><InputMapping>P1Button2</InputMapping></JoystickButtons>
    <JoystickButtons><ButtonName>MVD Holder</ButtonName><InputMapping>P1Button3</InputMapping></JoystickButtons>
    <JoystickButtons><ButtonName>Gun X</ButtonName><InputMapping>Analog0</InputMapping><AnalogType>AnalogJoystick</AnalogType><HideWithRawInput>true</HideWithRawInput></JoystickButtons>
    <JoystickButtons><ButtonName>Gun Y</ButtonName><InputMapping>Analog2</InputMapping><AnalogType>AnalogJoystick</AnalogType><HideWithRawInput>true</HideWithRawInput></JoystickButtons>
    <JoystickButtons><ButtonName>Light Gun</ButtonName><InputMapping>P1LightGun</InputMapping><HideWithDirectInput>true</HideWithDirectInput><HideWithXInput>true</HideWithXInput></JoystickButtons>
  </JoystickButtons>
</GameProfile>
