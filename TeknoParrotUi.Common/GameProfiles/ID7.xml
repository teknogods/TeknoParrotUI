			<FieldValue>192.168.1.2</FieldValue>
			<FieldType>Text</FieldType>
			<Hint>Advanced. The cabinet's address in the game's EEPROM network record (when Dhcp is off). Not used for online or LAN play.</Hint>
		</FieldInformation>
		<FieldInformation>
			<CategoryName>Network</CategoryName>
			<FieldName>Mask</FieldName>
			<VisibleWhen>Show settings</VisibleWhen>
