<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plain net8.0: compiles for Windows, Linux and macOS.
         Windows-only functionality (raw input, XInput registry lookup, memory-mapped
         JVS state) is annotated [SupportedOSPlatform("windows")] at class level. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TeknoParrotUi.Common</RootNamespace>
    <!-- CA1416: the emulation layer (JVS memory-mapped state, raw input, XInput registry
         lookup, pipes) is inherently Windows-only at runtime. Profile/config/metadata APIs
         are fully portable. Suppressed here instead of annotating ~80 pipe classes;
         revisit when Linux game-running support becomes a real goal. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AssemblyName>TeknoParrotUi.Common</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- Local private-core qualification only. Public Android workflows never
       set this property and retain the open-source runtime catalog policy. -->
  <PropertyGroup Condition="'$(TeknoParrotPrivateAndroidTests)' == 'true'">
    <DefineConstants>$(DefineConstants);TP_ANDROID_PRIVATE_CORES</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <OutputPath>..\bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>..\bin\x86\Debug\</OutputPath>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>..\bin\x86\Release\</OutputPath>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.82" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="RawInput.Sharp" Version="0.1.3" />
    <!-- 10.x still targets net8.0, while shipping Android-16-compatible native
         runtime assets. The 8.0.0 Linux fallback library was only 4 KB aligned
         and triggered XA0141 when consumed by the net10.0-android head. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.9" />
    <PackageReference Include="Utf8Json" Version="1.3.7" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Metadata\*.json" />
    <None Remove="AndroidLaunchRecipes\*.json" />
    <None Remove="GameProfiles\*.xml" />
    <None Remove="GameSetup\*.xml" />
    <None Remove="HookedWindows.txt" />
    <None Remove="Icons\TeknoVegas.png" />
    <Content Include="Metadata\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="AndroidLaunchRecipes\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="GameProfiles\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="GameSetup\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="HookedWindows.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Icons\TeknoVegas.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
