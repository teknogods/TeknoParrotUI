<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TeknoParrotUi.Avalonia.Views"
             x:Class="TeknoParrotUi.Avalonia.Views.AnnouncementView">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Name="Heading" Margin="20,14" FontSize="18" FontWeight="SemiBold" />
        <Grid Name="HistoryPanel" Grid.Row="1" Margin="20,0,20,10" ColumnDefinitions="Auto,*,Auto" IsVisible="False">
            <Button Name="NewerArticle" Content="Newer" Click="NewerArticle_Click" Margin="0,0,8,0" />
            <ComboBox Name="ArticlePicker" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ArticlePicker_SelectionChanged" />
            <Button Name="OlderArticle" Content="Older" Grid.Column="2" Click="OlderArticle_Click" Margin="8,0,0,0" />
        </Grid>
        <Grid Grid.Row="2" Margin="20,0,20,0">
            <views:NewsWebView Name="Browser"
                           NavigationStarted="Browser_NavigationStarted"
                           NavigationCompleted="Browser_NavigationCompleted"
                           NewWindowRequested="Browser_NewWindowRequested" />
            <Border Name="MessagePanel" Background="{DynamicResource TpSurface2}" IsVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="520" Spacing="14" Margin="20">
                    <TextBlock Name="MessageText" TextWrapping="Wrap" TextAlignment="Center" />
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Name="RetryButton" Margin="4" Click="Retry_Click" />
                        <Button Name="OpenBrowserButton" Margin="4" Click="OpenBrowser_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="20,12,20,20" Spacing="8">
            <StackPanel Name="SupportPanel" Spacing="4">
                <TextBlock Name="SupportTitle" FontWeight="Bold" />
                <TextBlock Name="SupportDescription" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel HorizontalAlignment="Right">
                <Button Name="CloseButton" Margin="4" Click="Close_Click" />
                <Button Name="SubscribeButton" Margin="4" Click="Subscribe_Click" />
                <Button Name="ExternalButton" Margin="4" Click="OpenBrowser_Click" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
