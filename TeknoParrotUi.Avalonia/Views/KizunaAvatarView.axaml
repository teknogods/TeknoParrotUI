<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TeknoParrotUi.Avalonia.Views.KizunaAvatarView">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Name="Heading" FontSize="20" FontWeight="Bold" />
        <TextBlock Name="Status" Grid.Row="1" TextWrapping="Wrap" Margin="0,8" />
        <Grid Name="EditorGrid" Grid.Row="2" ColumnDefinitions="320,*">
            <ScrollViewer>
                <StackPanel Name="Fields" Spacing="7">
                    <ComboBox Name="Side" SelectionChanged="SideChanged" />
                    <ComboBox Name="Body" SelectionChanged="FieldChanged" />
                    <ComboBox Name="Voice" SelectionChanged="FieldChanged" />
                    <ComboBox Name="Greeting" SelectionChanged="FieldChanged" />
                    <Button Name="Play" Click="PlayClicked" />
                    <CheckBox Name="AllBodies" IsCheckedChanged="AllBodiesChanged" />
                    <StackPanel Name="Parts" Spacing="7" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Image Name="Preview" Stretch="Uniform" MaxHeight="360" />
                <TextBlock Name="PreviewStatus" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Name="Save" Click="SaveClicked" Margin="4" />
            <Button Name="Defaults" Click="DefaultClicked" Margin="4" />
            <Button Name="Remove" Click="RemoveClicked" Margin="4" />
            <Button Name="Back" Click="BackClicked" Margin="4" />
        </WrapPanel>
    </Grid>
</UserControl>
