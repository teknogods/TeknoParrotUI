<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TeknoParrotUi.Avalonia.Views.GameRunningView">
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Name="Header" Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap" />
        <SelectableTextBlock Name="StatusText" Grid.Row="1" Opacity="0.7" Margin="0,0,0,8" TextWrapping="Wrap" />
        <ScrollViewer Name="ConsoleScroll" Grid.Row="2" MinHeight="0">
            <SelectableTextBlock Name="ConsoleText" FontFamily="Consolas,monospace" FontSize="11" TextWrapping="Wrap" />
        </ScrollViewer>
        <StackPanel Name="ActionsPanel" Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" HorizontalAlignment="Center">
            <Button Name="BtnForceQuit" Content="Force Quit Game" Width="180" Click="BtnForceQuit_Click" />
            <Button Name="BtnBack" Content="Back to Library" Width="180" Click="BtnBack_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</UserControl>
