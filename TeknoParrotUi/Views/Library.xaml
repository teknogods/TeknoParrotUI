<?xml version="1.0" encoding="UTF-8" ?>
<UserControl x:Class="TeknoParrotUi.Views.Library"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TeknoParrotUi.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TeknoParrotUi.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:p="clr-namespace:TeknoParrotUi.Properties"
             xmlns:uc="clr-namespace:TeknoParrotUi.UserControls"
             d:DesignHeight="706"
             d:DesignWidth="800"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="pack://application:,,,/Resources/#Inter"
             Loaded="UserControl_Loaded"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:IsLessThanConverter x:Key="IsLessThan" />
        <converters:MathConverter x:Key="MathConverter" />
        <Style x:Key="LibraryActionButton"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height"
                    Value="Auto" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
        </Style>
        <Style x:Key="SecondaryActionButton"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height"
                    Value="Auto" />
            <Setter Property="Margin"
                    Value="2,4,2,2" />
            <Setter Property="Padding"
                    Value="8,0" />
            <Setter Property="Foreground"
                    Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="MainLibraryGrid"
          SizeChanged="MainLibraryGrid_SizeChanged"
          Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition x:Name="IconRow">
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=ActualHeight, ElementName=MainLibraryGrid, Converter={StaticResource IsLessThan}, ConverterParameter=500}"
                                         Value="True">
                                <Setter Property="Height"
                                        Value="0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=ActualHeight, ElementName=MainLibraryGrid, Converter={StaticResource IsLessThan}, ConverterParameter=500}"
                                         Value="False">
                                <Setter Property="Height"
                                        Value="240*" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition Height="287*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="55*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.8*" />
            <ColumnDefinition Width="0.8*" MinWidth="140" />
            <ColumnDefinition Width="0.8*" MinWidth="140" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0"
              Grid.Column="0"
              Margin="4,4,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Height="30"
                     Margin="4,0,0,0"
                     VerticalAlignment="Center"
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     TextChanged="SearchBox_TextChanged" />
            <Button x:Name="ResetFiltersButton"
                    Grid.Column="1"
                    Width="30"
                    Height="30"
                    Margin="4,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="{x:Static p:Resources.LibraryResetFilters}"
                    AutomationProperties.Name="{x:Static p:Resources.LibraryResetFilters}"
                    Click="ResetFiltersButton_Click">
                <materialDesign:PackIcon Kind="FilterRemove"
                                         Width="20"
                                         Height="20" />
            </Button>
        </Grid>
        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Margin="8,4,4,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
            <StackPanel.Resources>
                <Style x:Key="FilterChip"
                       TargetType="Border">
                    <Setter Property="Height"
                            Value="30" />
                    <Setter Property="Margin"
                            Value="0,0,8,0" />
                    <Setter Property="Padding"
                            Value="12,0,4,0" />
                    <Setter Property="CornerRadius"
                            Value="15" />
                    <Setter Property="BorderThickness"
                            Value="1" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource MaterialDesign.Brush.TextBox.OutlineInactiveBorder}" />
                    <Setter Property="Background"
                            Value="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}" />
                </Style>
                <Style x:Key="FilterChipComboBox"
                       TargetType="ComboBox"
                       BasedOn="{StaticResource MaterialDesignComboBox}">
                    <Setter Property="MinWidth"
                            Value="60" />
                    <Setter Property="MaxWidth"
                            Value="240" />
                    <Setter Property="Margin"
                            Value="6,0,0,0" />
                    <Setter Property="Padding"
                            Value="0,0,0,0" />
                    <Setter Property="VerticalAlignment"
                            Value="Center" />
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                    <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility"
                            Value="Collapsed" />
                    <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush"
                            Value="Transparent" />
                    <Setter Property="BorderThickness"
                            Value="0" />
                </Style>
            </StackPanel.Resources>
            <Border Style="{StaticResource FilterChip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static p:Resources.LibraryGenreLabel}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                    <ComboBox x:Name="GenreBox"
                              Style="{StaticResource FilterChipComboBox}"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="FilterBox_SelectionChanged" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FilterChip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static p:Resources.LibraryPlatformLabel}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                    <ComboBox x:Name="PlatformBox"
                              Style="{StaticResource FilterChipComboBox}"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="FilterBox_SelectionChanged" />
                </StackPanel>
            </Border>
        </StackPanel>
        <Image Grid.Row="1"
               Grid.Column="1"
               Width="8"
               Height="8"
               Margin="135,124,19,108"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="Fant"
               Source="/TeknoParrotUi;component/Resources/blank_24bit.png" />
        <Image x:Name="gameIcon"
               Grid.Row="0"
               Grid.RowSpan="3"
               Grid.Column="1"
               Grid.ColumnSpan="2"
               Margin="10,10,10,12"
               RenderOptions.BitmapScalingMode="Fant"
               Source="/TeknoParrotUi;component/Resources/teknoparrot_by_pooterman-db9erxd.png">
            <Image.Style>
                <Style TargetType="Image">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=ActualHeight, ElementName=MainLibraryGrid, Converter={StaticResource IsLessThan}, ConverterParameter=500}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
        <ListBox x:Name="gameList"
                 Grid.Row="2"
                 Grid.RowSpan="10"
                 Margin="4"
                 BorderThickness="0"
                 SelectionChanged="ListBox_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style BasedOn="{StaticResource AccentListBoxItem}"
                       TargetType="ListBoxItem">
                    <EventSetter Event="MouseDoubleClick"
                                 Handler="GameListItem_MouseDoubleClick" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <StackPanel Grid.Column="1"
                    Grid.ColumnSpan="2">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Grid.Row"
                            Value="3" />
                    <Setter Property="Grid.RowSpan"
                            Value="1" />
                    <Setter Property="Margin"
                            Value="10,0,10,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=ActualHeight, ElementName=MainLibraryGrid, Converter={StaticResource IsLessThan}, ConverterParameter=500}"
                                     Value="True">
                            <Setter Property="Grid.Row"
                                    Value="0" />
                            <Setter Property="Grid.RowSpan"
                                    Value="4" />
                            <Setter Property="Margin"
                                    Value="10,10,10,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <!-- Filled in by ShowGameInfo() in the code-behind. -->
            <Grid x:Name="gameInfoGrid"
                  Margin="10,0"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
            <Border x:Name="gameNotesPanel"
                    Margin="10,10,10,0"
                    Padding="10,8"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.OutlineInactiveBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <DockPanel>
                    <materialDesign:PackIcon Width="18"
                                             Height="18"
                                             Margin="0,1,8,0"
                                             VerticalAlignment="Top"
                                             DockPanel.Dock="Left"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                             Kind="InformationOutline" />
                    <TextBlock x:Name="gameNotesText"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <uc:GpuCompatibilityDisplay x:Name="gpuCompatibilityDisplay"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center" />

        </StackPanel>
        <!-- Action rows are stacked from the bottom up by LayoutActionRows() in the code-behind. -->
        <UniformGrid x:Name="playRow"
                     Grid.Row="7"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Margin="6,0"
                     Rows="1">
            <Button x:Name="gameLaunchButton"
                    Height="Auto"
                    Margin="4,4,4,2"
                    HorizontalContentAlignment="Left"
                    Click="BtnLaunchGame">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Kind="Play"
                                             Height="24"
                                             Width="24" />
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="{x:Static p:Resources.LibraryPlay}" />
                </StackPanel>
            </Button>
            <Button x:Name="playOnlineButton"
                    Margin="4,4,4,2"
                    Style="{StaticResource LibraryActionButton}"
                    Visibility="Collapsed"
                    Click="BtnPlayOnlineClick">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Kind="Web"
                                             Height="24"
                                             Width="24" />
                    <TextBlock FontSize="14"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{x:Static p:Resources.LibraryPlayOnline}" />
                </StackPanel>
            </Button>
        </UniformGrid>
        <Button x:Name="gameSettingsButton"
                Grid.Row="8"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="10,4,10,2"
                Style="{StaticResource LibraryActionButton}"
                Click="BtnGameSettings">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Kind="Settings"
                                         Height="24"
                                         Width="24" />
                <TextBlock FontSize="14"
                           VerticalAlignment="Center"
                           Text="{x:Static p:Resources.LibraryGameSettings}" />
            </StackPanel>
        </Button>
        <Button x:Name="controllerSetupButton"
                Grid.Row="9"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="10,4,10,2"
                Style="{StaticResource LibraryActionButton}"
                Click="BtnControllerSettings">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Kind="ControllerClassic"
                                         Height="24"
                                         Width="24" />
                <TextBlock FontSize="14"
                           VerticalAlignment="Center"
                           Text="{x:Static p:Resources.LibraryControllerSetup}" />
            </StackPanel>
        </Button>
        <Button x:Name="wikiButton"
                Grid.Row="10"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="10,4,10,2"
                Style="{StaticResource LibraryActionButton}"
                Click="BtnMoreInfo">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Kind="Information"
                                         Height="24"
                                         Width="24" />
                <TextBlock FontSize="14"
                           VerticalAlignment="Center"
                           Text="{x:Static p:Resources.LibraryMoreInfo}" />
            </StackPanel>
        </Button>
        <UniformGrid x:Name="extrasRow"
                     Grid.Row="10"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Margin="6,0"
                     Rows="1"
                     Visibility="Collapsed">
            <Button x:Name="gameOnlineProfileButton"
                    Margin="4,4,4,2"
                    Style="{StaticResource LibraryActionButton}"
                    Visibility="Collapsed"
                    Click="BtnOnlineProfile">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Kind="AccountCircle"
                                             Height="24"
                                             Width="24" />
                    <TextBlock FontSize="14"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{x:Static p:Resources.LibraryOnlineProfile}" />
                </StackPanel>
            </Button>
            <Button x:Name="highScoreButton"
                    Margin="4,4,4,2"
                    Style="{StaticResource LibraryActionButton}"
                    Visibility="Collapsed"
                    Click="BtnHighScores">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Kind="TrophyVariant"
                                             Height="24"
                                             Width="24" />
                    <TextBlock FontSize="14"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="HIGH SCORES" />
                </StackPanel>
            </Button>
        </UniformGrid>
        <StackPanel x:Name="secondaryActionsRow"
                    Grid.Row="11"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="6,0,6,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Button x:Name="testMenuButton"
                    Style="{StaticResource SecondaryActionButton}"
                    Click="BtnLaunchTestMenu">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon x:Name="testMenuIcon"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Kind="TestTube"
                                             Height="20"
                                             Width="20" />
                    <TextBlock x:Name="testMenuText"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Text="{x:Static p:Resources.LibraryTestMode}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SecondaryActionButton}"
                    Click="BtnVerifyGame">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Kind="FileCheck"
                                             Height="20"
                                             Width="20" />
                    <TextBlock FontSize="13"
                               VerticalAlignment="Center"
                               Text="{x:Static p:Resources.LibraryVerifyGame}" />
                </StackPanel>
            </Button>
            <Button x:Name="delGame"
                    Click="BtnDeleteGame"
                    IsEnabled="False">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource SecondaryActionButton}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="#E53935" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.ToolTip>
                    <TextBlock Text="{x:Static p:Resources.LibraryDeleteGame}" />
                </Button.ToolTip>
                <materialDesign:PackIcon VerticalAlignment="Center"
                                         Kind="TrashCanOutline"
                                         Height="20"
                                         Width="20" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
