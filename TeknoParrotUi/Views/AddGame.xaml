<UserControl
    x:Class="TeknoParrotUi.Views.AddGame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TeknoParrotUi.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TeknoParrotUi.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:TeknoParrotUi.Properties"
    d:DesignHeight="770"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="pack://application:,,,/Resources/#Inter"
    Loaded="UserControl_Loaded"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:IsLessThanConverter x:Key="IsLessThan" />
    </UserControl.Resources>
    <Grid x:Name="MainAddGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="16,12,0,4"
            FontSize="16"
            FontWeight="SemiBold"
            Text="{x:Static p:Resources.GameList}" />
        <ListBox
            x:Name="stockGameList"
            Grid.Row="1"
            Grid.Column="0"
            Margin="4,0,4,4"
            ItemContainerStyle="{StaticResource AccentListBoxItem}"
            SelectionChanged="StockGameList_SelectionChanged" />

        <DockPanel
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="12,12,16,12"
            LastChildFill="False">
            <TextBlock
                DockPanel.Dock="Top"
                Margin="0,0,0,4"
                FontSize="16"
                FontWeight="SemiBold"
                Text="{x:Static p:Resources.AddGameFilters}" />
            <TextBox
                x:Name="GameSearchBox"
                DockPanel.Dock="Top"
                Margin="0,8,0,0"
                materialDesign:HintAssist.Hint="{x:Static p:Resources.AddGameSearch}"
                materialDesign:TextFieldAssist.HasClearButton="True"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                Text=""
                TextChanged="UserControl_Loaded" />
            <ComboBox
                x:Name="GenreBox"
                DockPanel.Dock="Top"
                Margin="0,12,0,0"
                materialDesign:HintAssist.Hint="{x:Static p:Resources.AddGameGenre}"
                materialDesign:HintAssist.IsFloating="True"
                DisplayMemberPath="DisplayName"
                SelectionChanged="UserControl_Loaded" />
            <ComboBox
                x:Name="PlatformBox"
                DockPanel.Dock="Top"
                Margin="0,12,0,0"
                materialDesign:HintAssist.Hint="{x:Static p:Resources.AddGamePlatformFilter}"
                materialDesign:HintAssist.IsFloating="True"
                DisplayMemberPath="DisplayName"
                SelectionChanged="UserControl_Loaded" />
            <Label
                x:Name="GameCountLabel"
                DockPanel.Dock="Top"
                Margin="0,8,0,0"
                Padding="0"
                Content="Games shown: 0/0"
                FontSize="12"
                Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />

            <materialDesign:Snackbar
                x:Name="AddGameSnackbar"
                DockPanel.Dock="Bottom"
                Panel.ZIndex="999" />
            <Button
                x:Name="DeleteButton"
                DockPanel.Dock="Bottom"
                Margin="0,6,0,0"
                Click="DeleteGameButton"
                IsEnabled="False">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                        <Setter Property="Foreground" Value="#E53935" />
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Kind="TrashCanOutline" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Static p:Resources.DeleteGame}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="AddContinueButton"
                DockPanel.Dock="Bottom"
                Margin="0,8,0,0"
                Click="AddGameAndContinueButton"
                Content="{x:Static p:Resources.AddGameAndContinue}"
                IsEnabled="False">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=DeleteButton}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button
                x:Name="AddButton"
                DockPanel.Dock="Bottom"
                Height="40"
                Margin="0,12,0,0"
                Click="AddGameButton"
                Content="{x:Static p:Resources.AddGameAndReturn}"
                IsEnabled="False">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=DeleteButton}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Image
                x:Name="gameIcon"
                DockPanel.Dock="Bottom"
                MaxHeight="220"
                Margin="0,16,0,0"
                RenderOptions.BitmapScalingMode="Fant"
                Source="/TeknoParrotUi;component/Resources/teknoparrot_by_pooterman-db9erxd.png">
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=ActualHeight, ElementName=MainAddGrid, Converter={StaticResource IsLessThan}, ConverterParameter=550}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </DockPanel>
    </Grid>
</UserControl>
