<UserControl x:Class="TeknoParrotUi.Views.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TeknoParrotUi.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:p="clr-namespace:TeknoParrotUi.Properties"
             d:DesignHeight="600"
             d:DesignWidth="800"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="pack://application:,,,/Resources/#Inter"
             Loaded="UserControl_Loaded"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SerialComboBoxItemStyle"
               TargetType="ComboBoxItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanSelect}"
                             Value="False">
                    <Setter Property="IsEnabled"
                            Value="False" />
                    <Setter Property="Foreground"
                            Value="Gray" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"
                       Text="{x:Static p:Resources.AccountPageTitle}" />
            <materialDesign:Card Grid.Row="1"
                                 Margin="0,0,0,20"
                                 Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="AccountCircle"
                                                 Width="32"
                                                 Height="32"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LoginStatusText"
                                       FontSize="16"
                                       Text="{x:Static p:Resources.AccountPageNotLoggedIn}" />
                            <TextBlock x:Name="UserTierText"
                                       Margin="0,4,0,0"
                                       FontSize="16"
                                       Visibility="Visible"
                                       Text="{x:Static p:Resources.AccountPageTierNone}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Row="1"
                            x:Name="LoginLogoutButton"
                            HorizontalAlignment="Right"
                            Click="LoginLogoutButton_Click"
                            Content="{x:Static p:Resources.AccountPageLogin}" />
                </Grid>
            </materialDesign:Card>
            <materialDesign:Card Grid.Row="2"
                                 x:Name="SubscriptionCard"
                                 Margin="0,0,0,20"
                                 Padding="16"
                                 Background="{DynamicResource MaterialDesignDivider}"
                                 Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{x:Static p:Resources.AccountPageSubscriptionManagement}"
                               FontWeight="Medium"
                               FontSize="16"
                               Margin="0,0,0,16" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{x:Static p:Resources.AccountPageExpiryDate}"
                                   Margin="0,0,16,12"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   x:Name="ExpiryDateText"
                                   Margin="0,0,0,12"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{x:Static p:Resources.AccountPageAvailableSerials}"
                                   Margin="0,8,16,0"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Row="1"
                              Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      x:Name="SerialsComboBox"
                                      Margin="0,8,8,0"
                                      Style="{DynamicResource MaterialDesignComboBox}"
                                      Background="{DynamicResource MaterialDesignPaper}"
                                      BorderBrush="{DynamicResource MaterialDesignDivider}"
                                      SelectionChanged="SerialsComboBox_SelectionChanged" />
                            <Button Grid.Column="1"
                                    x:Name="RegisterSerialButton"
                                    Content="{x:Static p:Resources.AccountPageRegister}"
                                    Margin="8,8,0,0"
                                    Click="RegisterSerialButton_Click" />
                        </Grid>
                    </Grid>
                    <TextBlock Grid.Row="2"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="{x:Static p:Resources.AccountPageSerialInstructions}" />
                </Grid>
            </materialDesign:Card>
            <materialDesign:Card Grid.Row="3"
                                 x:Name="UserInfoCard"
                                 Margin="0,0,0,20"
                                 Padding="16"
                                 Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="2"
                               FontWeight="Medium"
                               FontSize="16"
                               Margin="0,0,0,16"
                               Text="{x:Static p:Resources.AccountPageAccountInformation}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,0,12"
                               Text="{x:Static p:Resources.AccountPageSegaID}" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             x:Name="SegaIdTextBox"
                             IsReadOnly="True"
                             materialDesign:HintAssist.Hint="{x:Static p:Resources.AccountPageSegaIDHint}"
                             Margin="0,0,0,12" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,0,12"
                               Text="{x:Static p:Resources.AccountPageNamcoID}" />
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             x:Name="NamcoIdTextBox"
                             IsReadOnly="True"
                             materialDesign:HintAssist.Hint="{x:Static p:Resources.AccountPageNamcoIDHint}"
                             Margin="0,0,0,12" />
                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,0,12"
                               Text="{x:Static p:Resources.AccountPageHighscoreSerial}" />
                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             x:Name="HighscoreSerialTextBox"
                             IsReadOnly="True"
                             materialDesign:HintAssist.Hint="{x:Static p:Resources.AccountPageHighscoreSerialHint}"
                             Margin="0,0,0,12" />
                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,0,12"
                               Text="{x:Static p:Resources.AccountPageMarioKartID}" />
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             x:Name="MarioKartIDTextBox"
                             IsReadOnly="True"
                             materialDesign:HintAssist.Hint="{x:Static p:Resources.AccountPageMarioKartIDHint}"
                             Margin="0,0,0,12" />
                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,0,12"
                               Text="{x:Static p:Resources.AccountPageGoldenTeePcbId}" />
                    <TextBox Grid.Row="5"
                             Grid.Column="1"
                             x:Name="GoldenTeePcbIdTextBox"
                             IsReadOnly="True"
                             materialDesign:HintAssist.Hint="{x:Static p:Resources.AccountPageGoldenTeeHint}"
                             Margin="0,0,0,12" />
                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,0,12"
                               Text="{x:Static p:Resources.AccountPageGoldenTeeCardId}" />
                    <TextBox Grid.Row="6"
                             Grid.Column="1"
                             x:Name="GoldenTeeCardIdTextBox"
                             IsReadOnly="True"
                             materialDesign:HintAssist.Hint="{x:Static p:Resources.AccountPageGoldenTeeHint}"
                             Margin="0,0,0,12" />
                </Grid>
            </materialDesign:Card>
            <!-- Initial D Online (IDENTITY_AND_BADGES.md 4.4): this PC's online ID, the rank (display only), who sees it. -->
            <materialDesign:Card Grid.Row="4"
                                 x:Name="InitialDOnlineCard"
                                 Margin="0,0,0,20"
                                 Padding="16">
                <StackPanel>
                    <TextBlock FontWeight="Medium"
                               FontSize="16"
                               Margin="0,0,0,8"
                               Text="{x:Static p:Resources.InitialDOnlineTitle}" />
                    <TextBlock TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Text="{x:Static p:Resources.InitialDOnlineIntro}" />
                    <!-- Why the website part is not there: not logged in, or teknoparrot.com has Initial D Online off -->
                    <TextBlock x:Name="InitialDWebsiteNote"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="Collapsed" />
                    <!-- The website part: rank, the account's Online ID, register / use here / regenerate / remove -->
                    <StackPanel x:Name="InitialDWebsitePanel"
                                Visibility="Collapsed">
                    <StackPanel x:Name="InitialDRankPanel"
                                Orientation="Horizontal"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Text="{x:Static p:Resources.InitialDOnlineYourRank}" />
                        <Border x:Name="InitialDRankBadge"
                                CornerRadius="4"
                                Padding="12,4"
                                Background="#FF141418">
                            <TextBlock x:Name="InitialDRankText"
                                       FontSize="18"
                                       FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="InitialDKingAuraText"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   FontWeight="Medium"
                                   Foreground="#FFFF5A00"
                                   Visibility="Collapsed"
                                   Text="{x:Static p:Resources.InitialDOnlineKingAura}" />
                    </StackPanel>
                    <TextBlock x:Name="InitialDPeasantNotice"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="Collapsed">
                        <Run Text="{x:Static p:Resources.InitialDOnlinePeasantNotice}" />
                        <Hyperlink NavigateUri="https://teknoparrot.com/OnlineProfile/InitialD"
                                   RequestNavigate="InitialDLearnMore_RequestNavigate">
                            <Run Text="{x:Static p:Resources.InitialDOnlineWearYourStars}" />
                        </Hyperlink>
                    </TextBlock>
                    <WrapPanel x:Name="InitialDLadderPanel"
                               Margin="0,0,0,12"
                               Visibility="Collapsed" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{x:Static p:Resources.InitialDOnlinePcbId}" />
                        <TextBox Grid.Column="1"
                                 x:Name="InitialDPcbIdTextBox"
                                 IsReadOnly="True"
                                 FontFamily="Consolas" />
                    </Grid>
                    <TextBlock x:Name="InitialDMachineText"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <StackPanel x:Name="InitialDVisibilityPanel"
                                Margin="0,4,0,8"
                                Visibility="Collapsed">
                        <TextBlock FontWeight="Medium"
                                   Margin="0,0,0,6"
                                   TextWrapping="Wrap"
                                   Text="{x:Static p:Resources.InitialDOnlineVisibilityTitle}" />
                        <RadioButton x:Name="InitialDVisPublic"
                                     GroupName="InitialDVisibility"
                                     Margin="0,2"
                                     FontWeight="Medium"
                                     Content="{x:Static p:Resources.InitialDOnlineVisibilityPublic}"
                                     Checked="InitialDVisibility_Checked" />
                        <RadioButton x:Name="InitialDVisOwn"
                                     GroupName="InitialDVisibility"
                                     Margin="0,2"
                                     Content="{x:Static p:Resources.InitialDOnlineVisibilityOwn}"
                                     Checked="InitialDVisibility_Checked" />
                        <RadioButton x:Name="InitialDVisOff"
                                     GroupName="InitialDVisibility"
                                     Margin="0,2"
                                     Content="{x:Static p:Resources.InitialDOnlineVisibilityOff}"
                                     Checked="InitialDVisibility_Checked" />
                        <StackPanel x:Name="InitialDPreviewPanel"
                                    Orientation="Horizontal"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed">
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Text="{x:Static p:Resources.InitialDOnlinePreviewCaption}" />
                            <Border x:Name="InitialDPreviewBadge"
                                    CornerRadius="4"
                                    Padding="12,4"
                                    Background="#FF141418">
                                <TextBlock x:Name="InitialDPreviewText"
                                           FontSize="16"
                                           FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Text="{x:Static p:Resources.InitialDOnlineVisibilityNote}" />
                        <Button x:Name="InitialDSaveVisibilityButton"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="{x:Static p:Resources.InitialDOnlineSaveVisibility}"
                                Click="InitialDSaveVisibility_Click" />
                    </StackPanel>
                    <WrapPanel HorizontalAlignment="Right"
                               Margin="0,4,0,0">
                        <Button x:Name="InitialDRegisterButton"
                                Margin="8,4,0,0"
                                Content="{x:Static p:Resources.InitialDOnlineRegisterButton}"
                                Click="InitialDRegister_Click" />
                        <Button x:Name="InitialDUseHereButton"
                                Margin="8,4,0,0"
                                Content="{x:Static p:Resources.InitialDOnlineUseHereButton}"
                                Click="InitialDUseHere_Click" />
                        <Button x:Name="InitialDRegenerateButton"
                                Margin="8,4,0,0"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="{x:Static p:Resources.InitialDOnlineRegenerateButton}"
                                Click="InitialDRegenerate_Click" />
                        <Button x:Name="InitialDRemoveButton"
                                Margin="8,4,0,0"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="{x:Static p:Resources.InitialDOnlineRemoveButton}"
                                Click="InitialDRemove_Click" />
                    </WrapPanel>
                    <TextBlock Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="{x:Static p:Resources.InitialDOnlineOnePcPerAccount}" />
                    </StackPanel>
                    <!-- By hand, logged in or not: an Online ID and its secret from the account's Initial D page -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{x:Static p:Resources.InitialDOnlinePcbId}" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 x:Name="InitialDManualIdTextBox"
                                 FontFamily="Consolas"
                                 materialDesign:HintAssist.Hint="AALG-ABC12345678"
                                 DataObject.Pasting="InitialDManual_Pasting" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,8,0,0"
                                   VerticalAlignment="Center"
                                   Text="{x:Static p:Resources.InitialDManualSecret}" />
                        <PasswordBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,8,0,0"
                                     x:Name="InitialDManualSecretBox"
                                     FontFamily="Consolas"
                                     DataObject.Pasting="InitialDManual_Pasting" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="{x:Static p:Resources.InitialDManualHint}" />
                    <TextBlock Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}">
                        <Hyperlink NavigateUri="https://teknoparrot.com/OnlineProfile/InitialD"
                                   RequestNavigate="InitialDLearnMore_RequestNavigate"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                   TextDecorations="Underline">
                            <Run Text="{x:Static p:Resources.InitialDManualOpenWebsite}" />
                        </Hyperlink>
                    </TextBlock>
                    <WrapPanel HorizontalAlignment="Right"
                               Margin="0,4,0,0">
                        <Button x:Name="InitialDManualSaveButton"
                                Margin="8,4,0,0"
                                Content="{x:Static p:Resources.InitialDManualSave}"
                                Click="InitialDManualSave_Click" />
                        <Button x:Name="InitialDManualClearButton"
                                Margin="8,4,0,0"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="{x:Static p:Resources.InitialDManualClear}"
                                Click="InitialDManualClear_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="InitialDLastStatusText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="InitialDMessageText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               FontWeight="Medium"
                               Visibility="Collapsed" />
                </StackPanel>
            </materialDesign:Card>
            <!-- Senjou no Kizuna Online: this PC's own Kizuna online ID (the game plays online only) and the rank, which
                 Kizuna always shows (display only, no visibility choice). -->
            <materialDesign:Card Grid.Row="5"
                                 x:Name="KizunaOnlineCard"
                                 Margin="0,0,0,20"
                                 Padding="16">
                <StackPanel>
                    <TextBlock FontWeight="Medium"
                               FontSize="16"
                               Margin="0,0,0,8"
                               Text="{x:Static p:Resources.KizunaOnlineTitle}" />
                    <TextBlock TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Text="{x:Static p:Resources.KizunaOnlineIntro}" />
                    <!-- Why the website part is not there: not logged in, or teknoparrot.com does not offer Kizuna IDs yet -->
                    <TextBlock x:Name="KizunaWebsiteNote"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="Collapsed" />
                    <!-- The website part: the account's rank and Online ID, register / use here / regenerate / remove -->
                    <StackPanel x:Name="KizunaWebsitePanel"
                                Visibility="Collapsed">
                    <StackPanel x:Name="KizunaRankPanel"
                                Orientation="Horizontal"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Text="{x:Static p:Resources.InitialDOnlineYourRank}" />
                        <Border x:Name="KizunaRankBadge"
                                CornerRadius="4"
                                Padding="12,4"
                                Background="#FF141418">
                            <TextBlock x:Name="KizunaRankText"
                                       FontSize="18"
                                       FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <WrapPanel x:Name="KizunaLadderPanel"
                               Margin="0,0,0,12"
                               Visibility="Collapsed" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{x:Static p:Resources.InitialDOnlinePcbId}" />
                        <TextBox Grid.Column="1"
                                 x:Name="KizunaPcbIdTextBox"
                                 IsReadOnly="True"
                                 FontFamily="Consolas" />
                    </Grid>
                    <TextBlock x:Name="KizunaMachineText"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <WrapPanel HorizontalAlignment="Right"
                               Margin="0,4,0,0">
                        <Button x:Name="KizunaRegisterButton"
                                Margin="8,4,0,0"
                                Content="{x:Static p:Resources.InitialDOnlineRegisterButton}"
                                Click="KizunaRegister_Click" />
                        <Button x:Name="KizunaUseHereButton"
                                Margin="8,4,0,0"
                                Content="{x:Static p:Resources.InitialDOnlineUseHereButton}"
                                Click="KizunaUseHere_Click" />
                        <Button x:Name="KizunaRegenerateButton"
                                Margin="8,4,0,0"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="{x:Static p:Resources.InitialDOnlineRegenerateButton}"
                                Click="KizunaRegenerate_Click" />
                        <Button x:Name="KizunaRemoveButton"
                                Margin="8,4,0,0"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="{x:Static p:Resources.InitialDOnlineRemoveButton}"
                                Click="KizunaRemove_Click" />
                    </WrapPanel>
                    <TextBlock Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="{x:Static p:Resources.InitialDOnlineOnePcPerAccount}" />
                    </StackPanel>
                    <!-- By hand: an Online ID and its secret for this PC, whatever the website offers -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{x:Static p:Resources.InitialDOnlinePcbId}" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 x:Name="KizunaManualIdTextBox"
                                 FontFamily="Consolas"
                                 materialDesign:HintAssist.Hint="AAKZ-ABC12345678"
                                 DataObject.Pasting="KizunaManual_Pasting" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,8,0,0"
                                   VerticalAlignment="Center"
                                   Text="{x:Static p:Resources.KizunaManualSecret}" />
                        <PasswordBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,8,0,0"
                                     x:Name="KizunaManualSecretBox"
                                     FontFamily="Consolas"
                                     DataObject.Pasting="KizunaManual_Pasting" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="{x:Static p:Resources.KizunaManualHint}" />
                    <TextBlock Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}">
                        <Hyperlink NavigateUri="https://teknoparrot.com/OnlineProfile/Kizuna"
                                   RequestNavigate="InitialDLearnMore_RequestNavigate"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                   TextDecorations="Underline">
                            <Run Text="{x:Static p:Resources.KizunaManualOpenWebsite}" />
                        </Hyperlink>
                    </TextBlock>
                    <WrapPanel HorizontalAlignment="Right"
                               Margin="0,4,0,0">
                        <Button x:Name="KizunaManualSaveButton"
                                Margin="8,4,0,0"
                                Content="{x:Static p:Resources.KizunaManualSave}"
                                Click="KizunaManualSave_Click" />
                        <Button x:Name="KizunaManualClearButton"
                                Margin="8,4,0,0"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Content="{x:Static p:Resources.KizunaManualClear}"
                                Click="KizunaManualClear_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="KizunaMessageText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               FontWeight="Medium"
                               Visibility="Collapsed" />
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Grid.Row="6"
                                 Margin="0,0,0,20"
                                 Padding="16"
                                 Background="{DynamicResource MaterialDesignDivider}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Information"
                                             Width="24"
                                             Height="24"
                                             VerticalAlignment="Top"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Text="{x:Static p:Resources.AccountPageIDUsageInfo}" />
                </Grid>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>