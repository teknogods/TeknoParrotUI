<?xml version="1.0" encoding="UTF-8" ?>
<UserControl x:Class="TeknoParrotUi.Views.SunshineManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="620"
             d:DesignWidth="900"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="pack://application:,,,/Resources/#Inter"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SectionCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="CornerRadius"
                    Value="8" />
            <Setter Property="Padding"
                    Value="18" />
            <Setter Property="Margin"
                    Value="0,0,14,14" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="18" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Margin"
                    Value="0,0,0,12" />
        </Style>

        <Style x:Key="MutedTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource MaterialDesignBodyLight}" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="WeatherSunny"
                                             Width="30"
                                             Height="30"
                                             Margin="0,1,10,0"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" />

                    <TextBlock Text="Sunshine Host"
                               FontSize="28"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Manage Sunshine, host connectivity, pairing, clients, and configuration from one place."
                           Margin="40,5,0,0"
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="12,6"
                    CornerRadius="14"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="SunshineStatusIndicator"
                             Width="9"
                             Height="9"
                             Fill="#8A8A8A"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center" />

                    <TextBlock x:Name="SunshineHeaderStatusText"
                               Text="Checking..."
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sunshine process -->
                <Border Grid.Column="0"
                        Grid.Row="0"
                        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Sunshine"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Kind="Server"
                                                     Width="34"
                                                     Height="34"
                                                     Margin="0,0,12,0"
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="SunshineStatusText"
                                           Text="Checking..."
                                           FontWeight="SemiBold" />

                                <TextBlock x:Name="SunshineStatusDetail"
                                           Text="Checking bundled Sunshine installation."
                                           Style="{StaticResource MutedTextStyle}" />

                                <TextBlock x:Name="ManagedApiDetailText"
                                           Text="Managed API disconnected"
                                           Margin="0,3,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnStartSunshine"
                                    Content="Start"
                                    Margin="0,0,8,0"
                                    MinWidth="92"
                                    Click="BtnStartSunshine_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />

                            <Button x:Name="BtnStopSunshine"
                                    Content="Stop"
                                    Margin="0,0,8,0"
                                    MinWidth="92"
                                    Click="BtnStopSunshine_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />

                            <Button x:Name="BtnRestartSunshine"
                                    Content="Restart"
                                    MinWidth="92"
                                    Click="BtnRestartSunshine_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Host connection -->
                <Border Grid.Column="1"
                        Grid.Row="0"
                        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Host Connection"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <RadioButton x:Name="RadioConnectionOpen"
                                         Content="Open"
                                         GroupName="SunshineConnectionMode"
                                         Margin="0,0,18,0"
                                         Checked="ConnectionMode_Checked" />

                            <RadioButton x:Name="RadioConnectionClosed"
                                         Content="Closed"
                                         GroupName="SunshineConnectionMode"
                                         Checked="ConnectionMode_Checked" />
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Effective state"
                                       Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="ConnectionStateText"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Text="—"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Row="1"
                                       Text="Active streams"
                                       Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="ActiveSessionsText"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Text="—" />

                            <TextBlock Grid.Row="2"
                                       Text="Paired clients"
                                       Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="PairedClientsText"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Text="—" />
                        </Grid>

                        <TextBlock x:Name="ConnectionModeDetailText"
                                   Text="Managed by TeknoParrot while the UI is running."
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Pairing -->
                <Border Grid.Column="0"
                        Grid.Row="1"
                        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Client Pairing"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock x:Name="PairingStatusText"
                                   Text="Waiting on pairing requests"
                                   Margin="0,0,0,12"
                                   Style="{StaticResource MutedTextStyle}" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Pairing PIN"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />

                                <TextBox x:Name="PairingPinTextBox"
                                         HorizontalContentAlignment="Center"
                                         MaxLength="4" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Connection Name"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />

                                <TextBox x:Name="PairingNameTextBox"
                                         HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="BtnPairClient"
                                Content="Pair Client"
                                HorizontalAlignment="Left"
                                MinWidth="110"
                                Click="BtnPairClient_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                </Border>

                <!-- Clients -->
                <Border Grid.Column="1"
                        Grid.Row="1"
                        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Moonlight Clients"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock x:Name="ClientListStatusText"
                                   Text="Waiting for Sunshine..."
                                   Margin="0,0,0,8"
                                   Style="{StaticResource MutedTextStyle}" />

                        <ListBox x:Name="ClientsListBox"
                                 MinHeight="86"
                                 MaxHeight="170"
                                 Margin="0,0,0,10"
                                 DisplayMemberPath="DisplayName"
                                 SelectionChanged="ClientsListBox_SelectionChanged" />

                        <WrapPanel>
                            <Button x:Name="BtnRefreshClients"
                                    Content="Refresh"
                                    Margin="0,0,8,8"
                                    MinWidth="92"
                                    Click="BtnRefreshClients_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />

                            <Button x:Name="BtnDisconnectAll"
                                    Content="Disconnect All"
                                    Margin="0,0,8,8"
                                    MinWidth="120"
                                    Click="BtnDisconnectAll_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />

                            <Button x:Name="BtnUnpairClient"
                                    Content="Unpair Selected"
                                    Margin="0,0,8,8"
                                    MinWidth="125"
                                    Click="BtnUnpairClient_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Future configuration -->
                <Border Grid.ColumnSpan="2"
                        Grid.Row="2"
                        Margin="0,0,14,14"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Kind="Cog"
                                                 Width="32"
                                                 Height="32"
                                                 Margin="0,0,14,0"
                                                 Foreground="{DynamicResource MaterialDesignBodyLight}" />

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Sunshine Configuration"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Audio, display, input, network, applications, and TeknoParrot-specific settings will live here."
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Coming next"
                                IsEnabled="False"
                                VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
