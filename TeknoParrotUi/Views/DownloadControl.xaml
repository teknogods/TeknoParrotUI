<UserControl
    x:Class="TeknoParrotUi.Views.DownloadControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TeknoParrotUi"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:TeknoParrotUi.Properties"
    d:DesignWidth="650"
    BorderThickness="0"
    FontFamily="pack://application:,,,/Resources/#Inter"
    Loaded="UserControl_Loaded"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    mc:Ignorable="d">
    <StackPanel Margin="16,12">
        <TextBlock
            x:Name="statusText"
            FontSize="14"
            Text="{x:Static p:Resources.DownloadControlDownloading}"
            TextTrimming="CharacterEllipsis" />
        <ProgressBar
            x:Name="progressBar"
            Height="6"
            Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
