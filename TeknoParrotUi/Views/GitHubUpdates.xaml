<UserControl
    x:Class="TeknoParrotUi.Views.GitHubUpdates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TeknoParrotUi.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:TeknoParrotUi.Properties"
    FontFamily="pack://application:,,,/Resources/#Inter"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    mc:Ignorable="d">
    <Grid
        x:Name="rowRoot"
        Background="Transparent"
        Cursor="Hand"
        MouseLeftButtonUp="Row_MouseLeftButtonUp">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border
            x:Name="hoverTint"
            Grid.ColumnSpan="3"
            Background="{DynamicResource MaterialDesign.Brush.Primary}"
            Opacity="0" />
        <CheckBox
            x:Name="isSelectedForUpdate"
            Grid.Column="0"
            Margin="14,0,8,0"
            VerticalAlignment="Center"
            IsChecked="True" />

        <StackPanel Grid.Column="1" Margin="4,10,12,10" VerticalAlignment="Center">
            <TextBlock
                x:Name="labelUpdated"
                FontSize="15"
                FontWeight="SemiBold"
                Text="{x:Static p:Resources.GitHubUpdatesDefaultComponent}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="labelVersion"
                Margin="0,2,0,0"
                FontSize="13"
                Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                Text="{x:Static p:Resources.GitHubUpdatesDefaultVersion}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Button
            Grid.Column="2"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Click="BtnChangelog"
            Style="{StaticResource MaterialDesignFlatButton}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="{x:Static p:Resources.UpdaterOpenChangelog}" />
                <materialDesign:PackIcon
                    Width="16"
                    Height="16"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Kind="OpenInNew" />
            </StackPanel>
        </Button>
    </Grid>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hoverTint" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.1" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="hoverTint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
