<UserControl
    x:Class="TeknoParrotUi.UserControls.JoystickControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TeknoParrotUi"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="clr-namespace:TeknoParrotUi.Properties"
    d:DesignHeight="706"
    d:DesignWidth="700"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="pack://application:,,,/Resources/#Inter"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource TeknoHintToolTip}" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="343*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="8*" />
            <RowDefinition Height="640*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <ScrollViewer
            Grid.Row="1"
            Grid.Column="1"
            Margin="10"
            VerticalScrollBarVisibility="Auto">
            <HeaderedItemsControl Name="JoystickMappingItems" Grid.Row="1">
                <HeaderedItemsControl.ItemTemplate>
                    <DataTemplate>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,0,0">
                                <TextBlock
                                    x:Name="ButtonLabel"
                                    Margin="2,10,12,0"
                                    FontSize="14"
                                    Loaded="Control_Loaded"
                                    Tag="{Binding}"
                                    Text="{Binding ButtonName}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="2,0,12,4"
                                    FontSize="11"
                                    FontWeight="Light"
                                    Opacity="0.6"
                                    Text="{Binding Hint}"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Hint}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=ButtonLabel}" Value="Collapsed">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,0">
                                <TextBox
                                    Margin="0,6"
                                    ContextMenu="{x:Null}"
                                    GotFocus="TextBox_GotFocus"
                                    IsReadOnly="true"
                                    Loaded="Control_Loaded"
                                    LostFocus="TextBox_LostFocus"
                                    SelectionOpacity="0"
                                    Tag="{Binding}"
                                    Text="{Binding BindName}"
                                    Unloaded="TextBox_Unloaded" />
                                <ComboBox
                                    Margin="0,6"
                                    IsEditable="False"
                                    IsReadOnly="True"
                                    Loaded="Control_Loaded"
                                    SelectionChanged="ComboBox_SelectionChanged"
                                    Tag="{Binding}"
                                    Text="{x:Static p:Resources.JoystickControlComboBoxDefault}" />
                            </StackPanel>
                        </UniformGrid>
                    </DataTemplate>
                </HeaderedItemsControl.ItemTemplate>
            </HeaderedItemsControl>
        </ScrollViewer>
        <Grid
            Grid.Row="3"
            Grid.Column="1"
            Grid.ColumnSpan="1"
            Height="49"
            VerticalAlignment="Top">
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    MinWidth="120"
                    Margin="5"
                    Click="JoystickGoBack_OnClick"
                    Content="{x:Static p:Resources.Back}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                <Button
                    MinWidth="160"
                    Margin="5"
                    Click="ButtonBase_OnClick"
                    Content="{x:Static p:Resources.SettingsSaveSettings}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
