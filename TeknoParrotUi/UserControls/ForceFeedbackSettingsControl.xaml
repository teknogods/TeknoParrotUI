<UserControl x:Class="TeknoParrotUi.UserControls.ForceFeedbackSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="pack://application:,,,/Resources/#Inter"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid Margin="15,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="8,0,8,12">
            <TextBlock Text="Force Feedback Settings" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="GameTitle" Margin="0,5,0,0" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Fields" Margin="8,0,12,0"/>
        </ScrollViewer>
        <TextBlock x:Name="SaveStatus" Grid.Row="2" Margin="8,8" TextWrapping="Wrap"/>
        <UniformGrid Grid.Row="3" Columns="2">
            <Button Margin="5" Content="Back" Click="GoBack"/>
            <Button Margin="5" Content="Save settings" Click="SaveSettings"/>
        </UniformGrid>
    </Grid>
</UserControl>
