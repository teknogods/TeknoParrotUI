<UserControl x:Class="TeknoParrotUi.UserControls.OutputSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="pack://application:,,,/Resources/#Inter"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid Margin="15,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="8,0,8,12">
            <TextBlock Text="Network Output Settings" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="GameTitle" Margin="0,5,0,0" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,0,12,0">
                <TextBlock Text="TCP Port" FontSize="15" FontWeight="SemiBold"/>
                <TextBox x:Name="ListenerPort" Margin="0,6,0,12" MaxLength="5"/>
                <TextBlock Text="Applications connect to this TCP port to receive game outputs. Use the same port in your receiving application. Default: 8000."
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <TextBlock Text="Line Ending" FontSize="15" FontWeight="SemiBold"/>
                <ComboBox x:Name="LineEnding" Margin="0,6,0,12"/>
                <TextBlock Text="Marks the end of each output message. CR is the default. Choose LF or CRLF if required by your receiving application."
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <CheckBox x:Name="Discovery" Content="UDP Discovery" Margin="0,0,0,6"/>
                <TextBlock Text="Sends announcements to the UDP port below so compatible applications on your local network can find the output service."
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <StackPanel IsEnabled="{Binding IsChecked, ElementName=Discovery}">
                    <TextBlock Text="UDP Discovery Port" FontSize="15" FontWeight="SemiBold"/>
                    <TextBox x:Name="DiscoveryPort" Margin="0,6,0,18" MaxLength="5"/>
                </StackPanel>
                <TextBlock Text="Receivers can connect from this computer or another computer using this PC's IP address. Changes apply the next time this game starts."
                           Opacity="0.7" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="SaveStatus" Grid.Row="2" Margin="8,8" TextWrapping="Wrap"/>
        <UniformGrid Grid.Row="3" Columns="2">
            <Button Margin="5" Content="Back" Click="GoBack"/>
            <Button Margin="5" Content="Save settings" Click="SaveSettings"/>
        </UniformGrid>
    </Grid>
</UserControl>
