{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build",
        "type": "shell",
        "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
        "args": [
          "TeknoParrotUI.sln",
          "/p:Configuration=Debug",
          "/p:Platform=x86",
          "/verbosity:minimal"
        ],
        "problemMatcher": "$msCompile",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "build (Release)",
        "type": "shell",
        "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
        "args": [
          "TeknoParrotUI.sln",
          "/p:Configuration=Release",
          "/p:Platform=x86",
          "/verbosity:minimal"
        ],
        "problemMatcher": "$msCompile",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "clean",
        "type": "shell",
        "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
        "args": [
          "TeknoParrotUI.sln",
          "/t:Clean",
          "/p:Configuration=Debug",
          "/verbosity:minimal"
        ],
        "problemMatcher": "$msCompile",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "rebuild",
        "type": "shell",
        "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
        "args": [
          "TeknoParrotUI.sln",
          "/t:Rebuild",
          "/p:Configuration=Debug",
          "/p:Platform=x86",
          "/verbosity:minimal"
        ],
        "problemMatcher": "$msCompile",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "build (auto-detect MSBuild)",
        "type": "shell",
        "command": "$msbuild = &'${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\Installer\\vswhere.exe' -latest -requires Microsoft.Component.MSBuild -find MSBuild\\**\\Bin\\MSBuild.exe -prerelease | Select-Object -First 1; if ($msbuild) { &$msbuild TeknoParrotUI.sln /p:Configuration=Debug /p:Platform=x86 /verbosity:minimal } else { Write-Error 'MSBuild not found' }",
        "problemMatcher": "$msCompile",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        },
        "options": {
          "shell": {
            "executable": "powershell.exe",
            "args": [
              "-NoProfile",
              "-Command"
            ]
          }
        }
      }
    ]
}
