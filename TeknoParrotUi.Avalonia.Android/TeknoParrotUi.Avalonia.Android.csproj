<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Avalonia.Android 12.x targets net10.0-android — this head builds with the
         .NET 10 SDK (user-local ~/.dotnet) while the desktop solution stays on
         net8.0. The net8.0 TeknoParrotUi.Avalonia/Common references are consumed
         via standard TFM compatibility. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <!-- Phone packages default to ARM64. Emulator scripts can still select
         android-x64 explicitly with -r without causing normal release builds
         to restore and AOT-compile both ABIs. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-arm64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.teknoparrot.ui</ApplicationId>
    <ApplicationVersion>9</ApplicationVersion>
    <ApplicationDisplayVersion>1.4</ApplicationDisplayVersion>
    <RootNamespace>TeknoParrotUi.Avalonia.Android</RootNamespace>
    <AssemblyName>TeknoParrotUi.Avalonia.Android</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ManagedAidlNamespace>TeknoParrotUi.AndroidBridge</ManagedAidlNamespace>
    <!-- TeknoParrotUi.Avalonia is a (non-self-contained) desktop Exe; we only
         consume its assembly (App/MainView/views), so the NETSDK1150
         self-contained-vs-framework-dependent check does not apply. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- Full TeknoParrot UI on Android: hosts the shared MainView (see
         TeknoParrotUi.Avalonia/Views/MainView) via Avalonia's single-view
         lifetime. Deliberately NOT part of TeknoParrotUI.sln so desktop
         builds never require the android workload.

         Build (same toolchain as the input-test head):
           TeknoParrotUi.Android/scripts/build-apk.sh builds the test harness;
           for this app:
           DOTNET_ROOT=~/.dotnet PATH=~/.dotnet:$PATH dotnet build TeknoParrotUi.Avalonia.Android \
             -t:SignAndroidPackage -p:EmbedAssembliesIntoApk=true \
             -p:AndroidSdkDirectory=$HOME/android-toolchain/sdk \
             -p:JavaSdkDirectory=$(ls -d $HOME/android-toolchain/jdk-17*) -->
    <!-- Avalonia XAML in referenced project is compiled there; this head has no XAML. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared UI/logic projects are pure AnyCPU IL (net8.0) — consume their
         plain (RID-less) build instead of forcing android RID passes through
         projects whose flat desktop output paths were never designed for them.
         UndefineProperties strips the RID/self-contained context from the P2P
         protocol; TFM compatibility (net10.0-android ← net8.0) does the rest. -->
    <ProjectReference Include="..\TeknoParrotUi.Avalonia\TeknoParrotUi.Avalonia.csproj"
                      UndefineProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.0.5" />
    <!-- Subscription activation is deferred for the first OpenParrot-only
         Android release. Do not compile the future backend into this APK. -->
    <Compile Remove="AndroidWinlatorActivationBackend.cs" />
  </ItemGroup>

  <ItemGroup>
    <AndroidInterfaceDescription Include="..\TeknoParrotUi.AndroidBridge\ITeknoParrotBridgeService.aidl"
                                 Link="AndroidBridge\ITeknoParrotBridgeService.aidl" />
    <AndroidInterfaceDescription Include="..\TeknoParrotUi.AndroidBridge\ITeknoParrotWinlatorService.aidl"
                                 Link="AndroidBridge\ITeknoParrotWinlatorService.aidl" />
    <AndroidInterfaceDescription Include="..\TeknoParrotUi.AndroidBridge\BridgeCapabilities.aidl"
                                 Link="AndroidBridge\BridgeCapabilities.aidl" />
    <AndroidInterfaceDescription Include="..\TeknoParrotUi.AndroidBridge\SessionSpec.aidl"
                                 Link="AndroidBridge\SessionSpec.aidl" />
    <AndroidInterfaceDescription Include="..\TeknoParrotUi.AndroidBridge\PreparedSession.aidl"
                                 Link="AndroidBridge\PreparedSession.aidl" />
    <Compile Include="..\TeknoParrotUi.AndroidBridge\BridgeProtocol.cs"
             Link="AndroidBridge\BridgeProtocol.cs" />
    <Compile Include="..\TeknoParrotUi.AndroidBridge\MappedSharedPage.cs"
             Link="AndroidBridge\MappedSharedPage.cs" />
    <Compile Include="..\TeknoParrotUi.AndroidBridge\WinlatorSessionContract.cs"
             Link="AndroidBridge\WinlatorSessionContract.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the read-only stock catalog with the APK. MainActivity seeds these
         assets into Android's private writable files directory on first run and
         when the application version changes. UserProfiles/InputBindings are
         deliberately not packaged or overwritten. -->
    <AndroidResource Include="..\TeknoParrotUi.Avalonia\Assets\teknoparrot.png"
                     Link="Resources\drawable\teknoparrot_launcher.png" />
    <AndroidAsset Include="..\TeknoParrotUi.Common\GameProfiles\**\*"
                  Link="GameProfiles\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\TeknoParrotUi.Common\Metadata\**\*"
                  Link="Metadata\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\TeknoParrotUi.Common\AndroidLaunchRecipes\**\*"
                  Link="AndroidLaunchRecipes\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\TeknoParrotUi.Common\GameSetup\**\*"
                  Link="GameSetup\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\TeknoParrotUi.Common\InputProfiles\**\*"
                  Link="InputProfiles\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
